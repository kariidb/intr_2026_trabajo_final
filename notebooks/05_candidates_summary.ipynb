# %% 1. Configuración e importación de librerías
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from pathlib import Path

# Asumiendo que ya tienes las rutas definidas en tu entorno
# Si no, define la ruta donde guardarás los resultados
DIR_RESULTADOS = Path("../results")
DIR_TABLAS = DIR_RESULTADOS / "tables"
DIR_FIGURAS = DIR_RESULTADOS / "figures"
DIR_TABLAS.mkdir(parents=True, exist_ok=True)
DIR_FIGURAS.mkdir(parents=True, exist_ok=True)

# Configuración de estilo
sns.set_theme(style="whitegrid")
PALETA = {"Sano": "#4C72B0", "Alzheimer": "#DD8452"}

# %% 2. Cargar resultados previos (si están guardados)
# Si guardaste los resultados de tus análisis previos, cárgalos aquí.
# Si no, puedes recrear las tablas resumen con el código de los notebooks anteriores.

# Cargar tablas de resumen clínico
resumen_num = pd.read_csv(DIR_TABLAS / "resumen_numericas_por_grupo.csv")
resumen_bin = pd.read_csv(DIR_TABLAS / "resumen_binarias_por_grupo.csv")

# Cargar las variables seleccionadas previamente
seleccion = pd.read_csv(DIR_TABLAS / "variables_seleccionadas.csv")

# En un escenario real, aquí cargarías tus resultados genómicos y proteicos.
# Como ejemplo, crearemos datos simulados basados en los hallazgos típicos.

# %% 3. Simulación de resultados genómicos y proteicos (Reemplazar con datos reales)
# Estos datos simulan los hallazgos de los notebooks de genómica y proteómica.

# 3.1 Datos genómicos simulados
genes = ["APP", "PSEN1", "APOE", "MAPT", "SNCA"]
mutaciones = {
    "APP": {"frecuencia_sanos": 0.02, "frecuencia_alzheimer": 0.15, "efecto_proteico": "Missense"},
    "PSEN1": {"frecuencia_sanos": 0.01, "frecuencia_alzheimer": 0.12, "efecto_proteico": "Missense"},
    "APOE": {"frecuencia_sanos": 0.15, "frecuencia_alzheimer": 0.45, "efecto_proteico": "Sinónimo"},
    "MAPT": {"frecuencia_sanos": 0.05, "frecuencia_alzheimer": 0.08, "efecto_proteico": "Sinónimo"},
    "SNCA": {"frecuencia_sanos": 0.03, "frecuencia_alzheimer": 0.10, "efecto_proteico": "Missense"},
}

df_mutaciones = pd.DataFrame(mutaciones).T.reset_index().rename(columns={"index": "gen"})
df_mutaciones["diferencia_frecuencia"] = df_mutaciones["frecuencia_alzheimer"] - df_mutaciones["frecuencia_sanos"]
df_mutaciones["razon_prevalencias"] = df_mutaciones["frecuencia_alzheimer"] / df_mutaciones["frecuencia_sanos"]

# 3.2 Datos proteicos simulados
proteinas = {
    "APP": {"cambio_aa": "Sí", "propiedad_alterada": "Hidrofobicidad"},
    "PSEN1": {"cambio_aa": "Sí", "propiedad_alterada": "Estructura secundaria"},
    "APOE": {"cambio_aa": "No", "propiedad_alterada": "Ninguna"},
    "MAPT": {"cambio_aa": "No", "propiedad_alterada": "Ninguna"},
    "SNCA": {"cambio_aa": "Sí", "propiedad_alterada": "Agregación"},
}
df_proteinas = pd.DataFrame(proteinas).T.reset_index().rename(columns={"index": "gen"})

# Combinar información genómica y proteica
df_candidatos_gen_prot = pd.merge(df_mutaciones, df_proteinas, on="gen", how="left")

# %% 4. Criterios de selección de candidatos diferenciales
# Basado en la guía, seleccionaremos candidatos que cumplan varios criterios.
# Los criterios son: diferencia entre grupos, consistencia, efecto proteico y relación clínica.

# 4.1 Definir umbrales para los criterios
UMBRAL_DIFERENCIA_FRECUENCIA = 0.05  # Diferencia mínima de frecuencia entre grupos
UMBRAL_RAZON_PREVALENCIAS = 2.0      # Razón de prevalencias mínima

# 4.2 Aplicar criterios
# Criterio 1: Diferencia entre grupos (genómico)
df_candidatos_gen_prot["cumple_diferencia"] = (
    (df_candidatos_gen_prot["diferencia_frecuencia"] >= UMBRAL_DIFERENCIA_FRECUENCIA) &
    (df_candidatos_gen_prot["razon_prevalencias"] >= UMBRAL_RAZON_PREVALENCIAS)
)

# Criterio 2: Efecto proteico
df_candidatos_gen_prot["cumple_efecto_proteico"] = (
    df_candidatos_gen_prot["cambio_aa"] == "Sí"
)

# Criterio 3: Consistencia (en este caso, asumimos que todos los candidatos son consistentes
# porque los datos son simulados. En un caso real, verificarías que la mutación
# aparece en múltiples pacientes del grupo Alzheimer.)
df_candidatos_gen_prot["cumple_consistencia"] = True

# Criterio 4: Relación clínica (usaremos las variables clínicas seleccionadas)
# Para este ejemplo, asumimos que los genes APP y PSEN1 tienen relación clínica
# con hipertensión y edad, basado en la literatura.
relacion_clinica = {
    "APP": True,
    "PSEN1": True,
    "APOE": False,
    "MAPT": False,
    "SNCA": False,
}
df_candidatos_gen_prot["relacion_clinica"] = df_candidatos_gen_prot["gen"].map(relacion_clinica)

# 4.3 Seleccionar candidatos que cumplan todos los criterios
df_candidatos_seleccionados = df_candidatos_gen_prot[
    df_candidatos_gen_prot["cumple_diferencia"] &
    df_candidatos_gen_prot["cumple_efecto_proteico"] &
    df_candidatos_gen_prot["cumple_consistencia"] &
    df_candidatos_gen_prot["relacion_clinica"]
]

# %% 5. Selección de candidatos clínicos
# Usaremos las variables clínicas seleccionadas previamente (del notebook 01_clinical_eda)
# y añadiremos criterios adicionales basados en la literatura.

# 5.1 Cargar o definir variables clínicas de interés
variables_clinicas = ["age", "systolic_bp_mmHg", "hypertension", "family_history_alzheimer"]
df_clinico = pd.read_csv("../raw_data/ficha_clinica/synthetic_alzheimer_patients_1000.csv")

# 5.2 Calcular estadísticas para las variables clínicas seleccionadas
# (esto ya debería estar hecho en el notebook 01, pero lo repetimos por claridad)
df_clinico["diagnostico"] = df_clinico["alzheimer"].map({0: "Sano", 1: "Alzheimer"})

resumen_clinico = {}
for var in variables_clinicas:
    if var in ["age", "systolic_bp_mmHg"]:
        resumen_clinico[var] = {
            "media_sano": df_clinico[df_clinico["diagnostico"] == "Sano"][var].mean(),
            "media_alzheimer": df_clinico[df_clinico["diagnostico"] == "Alzheimer"][var].mean(),
            "diferencia": df_clinico[df_clinico["diagnostico"] == "Alzheimer"][var].mean() -
                          df_clinico[df_clinico["diagnostico"] == "Sano"][var].mean(),
        }
    else:  # Variables binarias
        resumen_clinico[var] = {
            "prevalencia_sano": df_clinico[df_clinico["diagnostico"] == "Sano"][var].mean() * 100,
            "prevalencia_alzheimer": df_clinico[df_clinico["diagnostico"] == "Alzheimer"][var].mean() * 100,
            "diferencia": (df_clinico[df_clinico["diagnostico"] == "Alzheimer"][var].mean() -
                          df_clinico[df_clinico["diagnostico"] == "Sano"][var].mean()) * 100,
        }

df_resumen_clinico = pd.DataFrame(resumen_clinico).T
df_resumen_clinico = df_resumen_clinico.round(2)

# 5.3 Seleccionar los candidatos clínicos más prometedores
# Basado en los criterios de la guía (diferencia entre grupos, consistencia, etc.)
# y la literatura.
candidatos_clinicos = {
    "edad": {
        "variable": "age",
        "tipo": "numérica",
        "diferencia": resumen_clinico["age"]["diferencia"],
        "evidencia": "Fuerte",
        "interpretacion": "Los pacientes con Alzheimer son significativamente mayores."
    },
    "hipertension": {
        "variable": "hypertension",
        "tipo": "binaria",
        "diferencia": resumen_clinico["hypertension"]["diferencia"],
        "evidencia": "Fuerte",
        "interpretacion": "La hipertensión es mucho más prevalente en Alzheimer."
    },
    "antecedentes_familiares": {
        "variable": "family_history_alzheimer",
        "tipo": "binaria",
        "diferencia": resumen_clinico["family_history_alzheimer"]["diferencia"],
        "evidencia": "Fuerte",
        "interpretacion": "Los antecedentes familiares son un factor de riesgo importante."
    }
}

df_candidatos_clinicos = pd.DataFrame(candidatos_clinicos).T

# %% 6. Combinar candidatos genómicos/proteicos y clínicos
# Crear una tabla unificada de candidatos diferenciales
candidatos_finales = []

# Añadir candidatos genómicos/proteicos
for _, row in df_candidatos_seleccionados.iterrows():
    candidatos_finales.append({
        "candidato": row["gen"],
        "tipo": "Genómico/Proteico",
        "evidencia": f"Frecuencia: {row['frecuencia_alzheimer']:.0%} vs {row['frecuencia_sanos']:.0%} (Alzheimer vs Sano)",
        "efecto_proteico": row["efecto_proteico"],
        "relacion_clinica": "Sí" if row["relacion_clinica"] else "No",
        "interpretacion": f"Mutación en {row['gen']} con cambio {row['cambio_aa']} y alteración de {row['propiedad_alterada']}.",
    })

# Añadir candidatos clínicos
for _, row in df_candidatos_clinicos.iterrows():
    if row["tipo"] == "numérica":
        evidencia = f"Diferencia de medias: {row['diferencia']:.1f} unidades"
    else:
        evidencia = f"Diferencia de prevalencia: {row['diferencia']:.1f} puntos porcentuales"

    candidatos_finales.append({
        "candidato": row["variable"],
        "tipo": "Clínico",
        "evidencia": evidencia,
        "efecto_proteico": "N/A",
        "relacion_clinica": "N/A",
        "interpretacion": row["interpretacion"],
    })

df_candidatos_finales = pd.DataFrame(candidatos_finales)

# Guardar resultados
df_candidatos_finales.to_csv(DIR_TABLAS / "candidatos_diferenciales.csv", index=False)

# %% 7. Visualización de los candidatos diferenciales

# 7.1 Gráfico de barras para los candidatos genómicos/proteicos
fig, ax = plt.subplots(figsize=(10, 6))
df_plot = df_candidatos_seleccionados.copy()
df_plot = df_plot.sort_values("diferencia_frecuencia", ascending=False)

x = np.arange(len(df_plot))
width = 0.35

ax.bar(x - width/2, df_plot["frecuencia_sanos"] * 100, width, label="Sanos", color=PALETA["Sano"])
ax.bar(x + width/2, df_plot["frecuencia_alzheimer"] * 100, width, label="Alzheimer", color=PALETA["Alzheimer"])

ax.set_xlabel("Gen")
ax.set_ylabel("Frecuencia de mutación (%)")
ax.set_title("Frecuencia de mutaciones en genes candidatos")
ax.set_xticks(x)
ax.set_xticklabels(df_plot["gen"])
ax.legend()

plt.tight_layout()
plt.savefig(DIR_FIGURAS / "candidatos_genomicos_frecuencias.png", dpi=300, bbox_inches="tight")
plt.show()

# 7.2 Tabla resumen de candidatos clínicos
fig, ax = plt.subplots(figsize=(10, 4))
ax.axis('tight')
ax.axis('off')
table_data = []
for _, row in df_candidatos_clinicos.iterrows():
    table_data.append([row["variable"], row["tipo"], f"{row['diferencia']:.2f}", row["evidencia"], row["interpretacion"]])

table = ax.table(cellText=table_data,
                 colLabels=["Variable", "Tipo", "Diferencia", "Evidencia", "Interpretación"],
                 cellLoc='center', loc='center')
table.auto_set_font_size(False)
table.set_fontsize(10)
table.scale(1.2, 1.5)

plt.title("Candidatos Clínicos Diferenciales", pad=20)
plt.tight_layout()
plt.savefig(DIR_FIGURAS / "candidatos_clinicos_tabla.png", dpi=300, bbox_inches="tight")
plt.show()

# 7.3 Gráfico combinado de candidatos finales
fig, ax = plt.subplots(figsize=(12, 6))
sns.barplot(data=df_candidatos_finales, x="candidato", y="evidencia",
            hue="tipo", dodge=False, ax=ax)
ax.set_xticklabels(ax.get_xticklabels(), rotation=45, ha="right")
ax.set_title("Candidatos Diferenciales por Tipo de Evidencia")
ax.set_ylabel("Evidencia")
ax.legend(title="Tipo de Candidato")

plt.tight_layout()
plt.savefig(DIR_FIGURAS / "candidatos_diferenciales_resumen.png", dpi=300, bbox_inches="tight")
plt.show()

# %% 8. Generar informe de candidatos seleccionados
print("\n" + "="*80)
print("CANDIDATOS DIFERENCIALES SELECCIONADOS")
print("="*80)

print("\n1. Candidatos Genómicos/Proteicos:")
for _, row in df_candidatos_seleccionados.iterrows():
    print(f"\n  Gen: {row['gen']}")
    print(f"    - Frecuencia en Sanos: {row['frecuencia_sanos']*100:.1f}%")
    print(f"    - Frecuencia en Alzheimer: {row['frecuencia_alzheimer']*100:.1f}%")
    print(f"    - Diferencia: {row['diferencia_frecuencia']*100:.1f}%")
    print(f"    - Razón de prevalencias: {row['razon_prevalencias']:.2f}")
    print(f"    - Efecto proteico: {row['efecto_proteico']}")
    print(f"    - Cambio en aa: {row['cambio_aa']}")
    print(f"    - Propiedad alterada: {row['propiedad_alterada']}")

print("\n2. Candidatos Clínicos:")
for _, row in df_candidatos_clinicos.iterrows():
    print(f"\n  Variable: {row['variable']}")
    print(f"    - Tipo: {row['tipo']}")
    print(f"    - Diferencia: {row['diferencia']:.2f}")
    print(f"    - Interpretación: {row['interpretacion']}")

print("\n3. Resumen de Candidatos Finales:")
print(df_candidatos_finales.to_string(index=False))

print("\n" + "="*80)
print("Los resultados se han guardado en la carpeta 'results'")
print("="*80)



